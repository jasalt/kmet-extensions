{:paths ["src" "test"]
 :tasks
 {test {:doc "Run offline tests (no browser): the pure snapshot namespace over a captured AX tree"
        :task (let [nss (if (seq *command-line-args*)
                          (map symbol *command-line-args*)
                          '[webdriver.snapshot-test])]
                (doseq [ns-sym nss] (require ns-sym))
                (let [summary (apply clojure.test/run-tests nss)]
                  (when (pos? (+ (:fail summary) (:error summary)))
                    (System/exit 1))))}
  test-changed {:doc "Run this extension's offline tests"
                :task (run 'test)}}}
