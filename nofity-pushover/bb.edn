{:paths ["src" "test" "../../kmet/src"]
 :tasks
 {test {:doc "Run selected offline test namespaces (default: this extension)"
        :task (let [nss (if (seq *command-line-args*)
                          (map symbol *command-line-args*)
                          '[nofity-pushover.core-test])]
                (doseq [ns-sym nss] (require ns-sym))
                (let [summary (apply clojure.test/run-tests nss)]
                  (when (pos? (+ (:fail summary) (:error summary)))
                    (System/exit 1))))}
  test-changed {:doc "Run this new extension's offline tests"
                :task (run 'test "nofity-pushover.core-test")}}}
